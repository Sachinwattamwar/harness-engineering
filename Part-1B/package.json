    "harness": "node .harness/run-harness.js",
    "eval": "node .harness/run-eval.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "luxon": "^3.5.0",
    "openai": "^4.67.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.14.0",
    "eslint-plugin-security": "^3.0.1",
    "vitest": "^5.1.0"
  }
}
