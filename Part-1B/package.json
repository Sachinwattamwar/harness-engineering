{
  "name": "nl-reminder-agent",
  "version": "1.0.0",
  "description": "NL Reminder Agent CLI \u2014 parses natural-language reminder requests via an LLM and returns structured JSON output.",
  "type": "module",
  "main": "src/agent.js",
  "bin": {
    "remind": "./bin/remind.js"
  },
  "scripts": {
    "lint": "eslint src bin .harness",
