# Copy this file to .env and fill in your values. Never commit .env.
# Provider adapter (FR-014): "openai" (default). "stub" is for tests only; npm run eval refuses it (FR-022).
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# Read by the openai SDK; required when LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here